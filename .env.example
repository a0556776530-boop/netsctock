FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret

# SQLite path — relative to the project root (dev) or absolute (prod)
DATABASE_URL=sqlite:///inventory.db

# Email reminders (optional — leave blank to disable)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
